<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+ cloud backup & device-to-device transfer. Exclude the
         local database (password hashes, bookings, transactions) so a
         restore onto a different device never silently carries over
         someone else's account/session data. -->
    <cloud-backup>
        <exclude domain="database" path="sanskar.db" />
        <exclude domain="database" path="sanskar.db-shm" />
        <exclude domain="database" path="sanskar.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sanskar.db" />
        <exclude domain="database" path="sanskar.db-shm" />
        <exclude domain="database" path="sanskar.db-wal" />
    </device-transfer>
</data-extraction-rules>
