# Copy to .env.local for local dev, and set these same values as
# Environment Variables in your Vercel project settings for production.

# --- Neon Postgres ---
# From your Neon project dashboard: Connection Details -> "Pooled connection".
# Prisma needs the pooled URL for serverless (Vercel functions), and Neon's
# unpooled URL for migrations (`prisma db push` / `prisma migrate`).
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Auth ---
# Any long random string (`openssl rand -hex 32`). Signs session JWTs.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (Resend — https://resend.com) ---
# Used for double opt-in signup verification and forgot-password emails.
# Without this set, emails are logged to the server console instead of sent
# (fine for local dev, NOT fine for production).
RESEND_API_KEY=""
EMAIL_FROM="Sanskar <onboarding@yourdomain.com>"

# --- App ---
# Public base URL used to build verification/reset links in emails.
# Locally: http://localhost:3000. On Vercel: your production domain,
# or leave unset to fall back to Vercel's own VERCEL_URL at runtime.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Publishable key is safe in client-side code (NEXT_PUBLIC_ prefix exposes
# it to the browser on purpose). The secret key is NOT — never prefix it
# with NEXT_PUBLIC_, never commit it, never paste it in chat. Use the
# test-mode keys (pk_test_.../sk_test_...) until checkout is fully built
# and verified; switch to live keys only when you're ready to take real
# payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# From Stripe Dashboard -> Developers -> Webhooks, after you add an
# endpoint at <your-domain>/api/stripe/webhook. Verifies that webhook
# requests really came from Stripe.
STRIPE_WEBHOOK_SECRET=""
