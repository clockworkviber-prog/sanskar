# Copy this file to keystore.properties (same folder, gitignored) and fill in
# your real release-signing values before running `gradlew bundleRelease`.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore sanskar-release.jks -alias sanskar \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Store the .jks file outside version control and keep the passwords in a
# secrets manager / CI secret store, not in this repo.

storeFile=../sanskar-release.jks
storePassword=CHANGE_ME
keyAlias=sanskar
keyPassword=CHANGE_ME
